# PostgreSQL — tương đương jdbc:postgresql://localhost:5432/car_marketplace
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_DB=car_marketplace

# Dev: sync=true chỉ an toàn trên DB trống. DB đã có users + FK → dùng false + scripts/pg-auth-schema-patch.sql
TYPEORM_SYNC=false
TYPEORM_LOGGING=false

# E2E / test không cần DB (jest set sẵn)
# SKIP_DATABASE=true

# Redis (auth-service — OTP)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# SKIP_REDIS=true

# Auth OTP / JWT
JWT_SECRET=change-me-in-production
PHONE_VERIFICATION_JWT_EXPIRES=15m
OTP_TTL_SECONDS=120
OTP_SMS_FAIL_COOLDOWN_SECONDS=30
JWT_EXPIRES_SEC=3600
JWT_PASSWORD_RESET_SEC=900

# Gọi nội bộ user-service sau khi OTP đúng
USER_SERVICE_URL=http://localhost:3003
INTERNAL_API_SECRET=dev-internal-shared-secret

# Cổng dịch vụ (tuỳ chỉnh)
# PORT=3001

# UC11 — đăng ký (pending Redis, khóa sau 3 lần sai OTP)
REGISTER_PENDING_TTL_SECONDS=900
REGISTER_LOCK_SECONDS=300
ACCESS_TOKEN_EXPIRES=7d
ACCESS_TOKEN_SECONDS=604800

# UC12 A3 — true = giả lỗi SMS (test)
# SMS_SIMULATE_FAILURE=true

PAYMENT_SERVICE_URL=http://localhost:3003