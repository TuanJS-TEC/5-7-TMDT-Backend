# PostgreSQL — tương đương jdbc:postgresql://localhost:5432/car_marketplace
# docker-compose.stack.yml: nếu host báo port 5432 đã dùng, đặt POSTGRES_PUBLISH_PORT=5433 (kết nối từ máy host qua cổng đó)
# POSTGRES_PUBLISH_PORT=5433
# Nếu port 3000 đã bận (npm start:dev gateway): API_GATEWAY_PUBLISH_PORT=3003 — gọi API tại http://localhost:3003
# API_GATEWAY_PUBLISH_PORT=3003
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_DB=car_marketplace

# Dev: sync=true chỉ an toàn trên DB trống. DB đã có users + FK → dùng false + scripts/pg-auth-schema-patch.sql
TYPEORM_SYNC=false
TYPEORM_LOGGING=false

# Payment-service: với TYPEORM_SYNC=false cần tạo bảng thủ công một lần:
#   psql -h localhost -U postgres -d car_marketplace -f scripts/payment-schema.sql
# (hoặc chạy nội dung file đó trong pgAdmin / DBeaver)

# E2E / test không cần DB (jest set sẵn)
# SKIP_DATABASE=true

# Redis (auth-service — OTP)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# SKIP_REDIS=true

# JWT — auth-service, listing-service, payment-service phải dùng CÙNG JWT_SECRET (ký/verify token).
# Docker stack: docker-dev-jwt-secret-change-me (xem docker-compose.stack.yml).
# Production: đặt chuỗi mạnh (không dùng $ — Compose coi $name là biến substitution).
JWT_SECRET=change-me-in-production
# listing-service (dev): bỏ qua AI khi upload ảnh
# SKIP_AI_IMAGE_VALIDATION=true
PHONE_VERIFICATION_JWT_EXPIRES=15m
OTP_TTL_SECONDS=120
OTP_SMS_FAIL_COOLDOWN_SECONDS=30
JWT_EXPIRES_SEC=3600
JWT_PASSWORD_RESET_SEC=900

# Bootstrap duy nhất 1 superadmin cho toàn hệ thống (auth-service tự tạo/sync khi khởi động)
SUPERADMIN_BOOTSTRAP_ENABLED=true
SUPERADMIN_PHONE=0900000009
SUPERADMIN_PASSWORD=SuperAdmin@123
SUPERADMIN_FULL_NAME=System Superadmin

# Gọi nội bộ user-service sau khi OTP đúng
USER_SERVICE_URL=http://localhost:3003
INTERNAL_API_SECRET=dev-internal-shared-secret

# Cổng dịch vụ (tuỳ chỉnh)
# PORT=3001

# UC11 — đăng ký (pending Redis, khóa sau 3 lần sai OTP)
REGISTER_PENDING_TTL_SECONDS=900
REGISTER_LOCK_SECONDS=300
ACCESS_TOKEN_EXPIRES=7d
ACCESS_TOKEN_SECONDS=604800

# UC12 A3 — true = giả lỗi SMS (test)
# SMS_SIMULATE_FAILURE=true

PAYMENT_SERVICE_URL=http://localhost:3003

# --- Web (Vite, apps/web) — dev: để trống để dùng proxy /api → Gateway :3000
# Production build: đặt URL gốc API (không có /api/v1 ở cuối)
# VITE_API_BASE=http://localhost:3000

# UC25 — listing-service: UUID admin nhận thông báo tin đã bán (phân tách bằng dấu phẩy)
# NOTIFICATION_ADMIN_USER_IDS=

# UC28 — payment-service (dev demo VietQR)
# PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret
# PAYMENT_DEMO_MODE=true
# VIETQR_USE_DEMO_IMAGE=true
