# PostgreSQL — tương đương jdbc:postgresql://localhost:5432/car_marketplace
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_DB=car_marketplace

# Dev: sync=true chỉ an toàn trên DB trống. DB đã có users + FK → dùng false + scripts/pg-auth-schema-patch.sql
TYPEORM_SYNC=false
TYPEORM_LOGGING=false

# E2E / test không cần DB (jest set sẵn)
# SKIP_DATABASE=true

# Auth service (JWT) — đặt JWT_SECRET mạnh trên production
JWT_SECRET=change-me-in-production
JWT_EXPIRES_SEC=3600
# Token đặt lại mật khẩu sau khi xác thực OTP (giây)
JWT_PASSWORD_RESET_SEC=900
# UC12 A3 — true = giả lỗi SMS (test)
# SMS_SIMULATE_FAILURE=true
